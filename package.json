{
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --watch --watch-path=server --watch-path=src/domain scripts/dev-model-server.mjs",
    "build": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build:evals": "vite build --config vite.evals.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:performance": "playwright test tests/e2e/performance.spec.ts --project=chromium-375",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && npm run typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:evals": "tsc --noEmit -p tsconfig.evals.json",
    "eval": "npm run typecheck:evals && npm run build:evals && node dist-evals/run-evals.js fixed",
    "eval:live": "npm run typecheck:evals && npm run build:evals && node dist-evals/run-evals.js live",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:server",
    "start": "node dist-server/index.js",
    "audit": "npm audit --omit=dev",
    "lighthouse": "npm run build && lhci autorun",
    "verify:production": "npm run build && npm run build:server && node scripts/verify-production.mjs",
    "chatgpt:server": "npm run build:server && node dist-server/index.js",
    "chatgpt:inspect": "npx @modelcontextprotocol/inspector http://localhost:8788/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "^6.46.0",
    "ws": "8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.13.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "eslint": "^10.6.0",
    "fake-indexeddb": "^6.2.5",
    "idb": "^8.0.3",
    "jsdom": "^29.1.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "latest",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
