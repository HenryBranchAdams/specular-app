{
  "name": "specular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env.local scripts/dev-model-server.mjs",
    "storybook": "STORYBOOK=true STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build:storybook": "STORYBOOK=true STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir storybook-static",
    "build": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "db:generate": "drizzle-kit generate",
    "build:evals": "vite build --config vite.evals.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:functional && npm run test:performance",
    "test:e2e:functional": "playwright test --grep-invert @performance",
    "test:e2e:integrated": "npm run build && playwright test --config playwright.integrated.config.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:performance": "playwright test --grep @performance --project=chromium-375 --workers=1 --retries=0",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.css\" && node scripts/validate-ui-style-ratchet.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && npm run typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:evals": "tsc --noEmit -p tsconfig.evals.json",
    "eval": "npm run typecheck:evals && npm run build:evals && node dist-evals/run-evals.js fixed",
    "eval:live": "npm run typecheck:evals && npm run build:evals && node --env-file-if-exists=.env.local dist-evals/run-evals.js live",
    "validate": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run build:server",
    "qualify:local": "npm run validate && npm run eval && npm run test:integration && npm run test:e2e && npm run test:e2e:integrated && npm run verify:pwa && npm run verify:production && npm run audit",
    "start": "node dist-server/index.js",
    "audit": "npm audit --omit=dev",
    "lighthouse": "npm run build && lhci autorun",
    "verify:production": "npm run build && npm run build:server && node scripts/verify-production.mjs",
    "verify:pwa": "npm run build && node scripts/verify-pwa-build.mjs",
    "validate:ui-inventory": "node scripts/validate-component-library-inventory.mjs",
    "ui:manifest:check": "node scripts/validate-ui-surface-manifest.mjs",
    "evidence:validate": "node scripts/write-release-evidence.mjs --output artifacts/release-evidence/validate.json --lane validate --suites typecheck,lint,coverage,eval,build,integration,pwa-verification --evidence-levels unit,worker-d1",
    "evidence:browser": "node scripts/write-release-evidence.mjs --output artifacts/release-evidence/browser.json --lane browser-and-lighthouse --suites mocked-playwright,integrated-playwright,lighthouse --evidence-levels synthetic-ui,integrated-browser,pwa-chromium,webkit-simulation",
    "chatgpt:server": "npm run build:server && node --env-file-if-exists=.env.local dist-server/index.js",
    "chatgpt:inspect": "mcp-inspector http://localhost:8788/mcp"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "openai": "^6.46.0",
    "radix-ui": "^1.6.2",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@modelcontextprotocol/inspector": "^0.22.0",
    "@openai/sites-vite-plugin": "^0.1.0",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.17.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "4.9.0",
    "idb": "^8.0.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.5.8",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1",
    "wrangler": "4.123.0"
  }
}
