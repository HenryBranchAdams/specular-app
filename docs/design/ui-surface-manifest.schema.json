{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specular.local/schemas/ui-surface-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "componentInventory", "dataPolicy", "storyCatalog", "routeCatalog", "surfaces", "legacyCompatibility"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "componentInventory": { "const": "docs/design/specular-component-library-inventory.json" },
    "dataPolicy": { "const": "synthetic-only-no-author-content" },
    "storyCatalog": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "routeCatalog": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "productionEntry", "patternIds", "requiredStates", "storyIds", "routeScenarios", "maturity", "exceptions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "productionEntry": { "type": "string", "minLength": 1 },
          "patternIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "requiredStates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "storyIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "routeScenarios": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "maturity": { "enum": ["transition", "ready", "deprecated"] },
          "exceptions": { "type": "array" }
        }
      }
    },
    "legacyCompatibility": { "type": "array", "items": { "type": "object" } }
  }
}
